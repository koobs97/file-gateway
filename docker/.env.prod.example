# =====================================================================
# 프로덕션 환경 변수 템플릿
# 이 파일을 복사해 docker/.env.prod 를 만들고 실제 값을 입력하세요.
# !! .env.prod 파일은 절대 git에 커밋하지 마세요 !!
# =====================================================================

# 데이터베이스
DB_NAME=file_gateway
DB_USER=gateway
DB_PASSWORD=your_db_password_here

# JWT (32자 이상의 랜덤 문자열)
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# 배포 이미지 태그 (deploy.sh 에서 덮어씀)
IMAGE_TAG=latest
